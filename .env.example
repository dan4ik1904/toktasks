# Скопируй в backend/.env и frontend/.env.local, заполни значения.

# --- Backend (backend/.env) ---
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
WEBAPP_URL=https://t.me/your_bot/app
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# LLM для Ярдәмче (необязательно — без него офлайн-режим)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BOT_USERNAME=your_bot
