BOT_TOKEN=
WEBAPP_URL=https://t.me/your_bot/app
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Прогресс (JSON-файл)
PROGRESS_FILE=data/progress.json
# Опционально: OpenAI-совместимый LLM для Ярдәмче.
# Если не задан — работает встроенный офлайн-режим (мини-словарь).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Tatsoft: публичные ручки (ключ не нужен). Голос TTS: alsu|almaz.
TATSOFT_API_KEY=
TATSOFT_TTS_BASE=https://tat-tts.api.translate.tatar
TATSOFT_TTS_SPEAKER=alsu
TATSOFT_STT_BASE=https://tat-asr.api.translate.tatar
TATSOFT_TRANSLATE_BASE=https://translate.tatar
