BOT_TOKEN=
WEBAPP_URL=https://t.me/your_bot/app
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Прогресс (JSON-файл)
PROGRESS_FILE=data/progress.json
# Опционально: OpenAI-совместимый LLM для Ярдәмче.
# Если не задан — работает встроенный офлайн-режим (мини-словарь).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Tatsoft: распознавание, озвучка, перевод татарского.
# Без них STT/TTS отвечают 503, перевод — по словарю островов.
# Пути сверь с документацией Tatsoft.
TATSOFT_API_KEY=
TATSOFT_BASE_URL=
TATSOFT_STT_PATH=/stt
TATSOFT_TTS_PATH=/tts
TATSOFT_TRANSLATE_PATH=/translate
